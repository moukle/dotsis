{
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": false
    },
    "provider": "copilot",
  },
  "auto_update_extensions": {
    "zedokai": false,
  },
  "outline_panel": {
    "dock": "left",
    "file_icons": true,
    "folder_icons": true,
    "button": true,
  },
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 0.7,
  },
  "window_decorations": "server",
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },
  "debugger": {
    "button": true,
  },
  "diagnostics": {
    "button": true,
  },
  "terminal": {
    "button": true,
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true,
  },
  "inlay_hints": {
    "show_background": false,
    "enabled": false,
  },
  "show_whitespaces": "trailing",
  "allow_rewrap": "in_comments",
  "soft_wrap": "editor_width",
  "minimap": {
    "max_width_columns": 80,
    "thumb": "always",
    "thumb_border": "none",
    "show": "never",
  },
  "agent_buffer_font_size": 15.0,
  "agent_ui_font_size": 15.0,
  "sticky_scroll": {
    "enabled": false,
  },
  "double_click_in_multibuffer": "open",
  "show_wrap_guides": true,
  "rounded_selection": true,
  "selection_highlight": true,
  "current_line_highlight": "all",
  "ui_font_weight": 400.0,
  "buffer_line_height": "standard",
  "lsp": {
    "JETLS": {
      "binary": {
        "arguments": ["--threads=1", "--", "serve"],
      },
    },
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
    "sort_by_path": true,
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "show_edit_predictions": false,
  "languages": {
    "Julia": {
      "show_edit_predictions": true,
    },
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
    "show_sign_in": true,
    "show_user_picture": false,
  },
  "agent": {
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "always_allow": [
            { "pattern": "^git\\s+(status|log|diff|branch)" },
            ]
        }
      }
    },
    "show_turn_stats": false,
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.5",
      },
    ],
    "default_profile": "write",
    "default_model": {
      "effort": "low",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
    },
  },
  "project_panel": {
    "sticky_scroll": true,
    "dock": "left",
    "default_width": 240.0,
    "hide_hidden": false,
    "hide_root": true,
    "indent_guides": {
      // "show": "never",
    },
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "entry_spacing": "standard",
    "hide_gitignore": false,
  },
  "base_keymap": "VSCode",
  "theme": {
    "mode": "light",
    "light": "Zedokai Light",
    "dark": "Zedokai Darker (Filter Ristretto)",
  },
  "unnecessary_code_fade": 0.8,
  "relative_line_numbers": "wrapped",
  "vim_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 0,
  },
  "ui_font_size": 18.0,
  "ui_font_family": "Fira Sans",
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_size": 18,
  "buffer_font_features": {
    "calt": true,
    "cv01": true,
    "cv03": true,
    "cv66": true,
    "ss03": true,
  },
  "git": {
    "inline_blame": { "enabled": false },
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show": true,
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
  "search": {
    "button": true,
    "whole_word": false,
    "case_sensitive": true,
    "include_ignored": false,
    "regex": false,
  },
  "toolbar": {
    "agent_review": false,
    "breadcrumbs": false,
    "code_actions": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 2,
    "line_width": 1,
    "enabled": true,
    // "coloring": "indent_aware"
  },
  "wrap_guides": [92],
}
