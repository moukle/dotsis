themes { // a node named "themes"
    mellow { // a nested node inside the "themes" node indicating the theme name
        // a list of nodes defining the UI components
        frame_selected {
            base 7
            background 0
            emphasis_0 7
            emphasis_1 7
            emphasis_2 7
            emphasis_3 7
        }
        frame_highlight {
            base 7
            background 0
            emphasis_0 7
            emphasis_1 7
            emphasis_2 7
            emphasis_3 7
        }

        frame_unselected {
            base 8
            background 0
            emphasis_0 1
            emphasis_1 7
            emphasis_2 6
            emphasis_3 5
        }

    }
}
