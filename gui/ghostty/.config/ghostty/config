# font-family = PragmataPro
font-family = Maple Mono NF
# font-family = Pragmasevka Nerd Font
font-size = 14
# adjust-font-baseline = 115%
adjust-cell-height = 18%

shell-integration-features = cursor, no-cursor, sudo, no-sudo, title, no-title
cursor-invert-fg-bg = true

window-inherit-working-directory = false
window-decoration = none
# window-height = 05
# window-width = 05
window-padding-x = 10
window-padding-y = 10
# window-padding-balance = true
# window-theme = ghostty

# working-directory = inherit
copy-on-select = true
confirm-close-surface = false

# theme = catppuccin-mocha
# background = 000000
# palette = 0=#252525
# palette = 8=#454545
# background-opacity = 0.85
background-blur = true
# background-blur = macos-glass-regular

app-notifications = no-clipboard-copy

keybind = alt+one=unbind
keybind = alt+two=unbind
keybind = alt+three=unbind
keybind = alt+four=unbind
keybind = alt+five=unbind
keybind = alt+six=unbind
keybind = alt+seven=unbind
keybind = alt+eight=unbind

theme = "/home/mori/.cache/wal/colors-ghostty.conf"
