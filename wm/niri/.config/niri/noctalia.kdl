layout {

    focus-ring {
        active-color   "#f9cc6c"
        inactive-color "#2c2525"
        urgent-color   "#fd6883"
    }

    border {
        active-color   "#f9cc6c"
        inactive-color "#2c2525"
        urgent-color   "#fd6883"
    }


    tab-indicator {
        active-color   "#f9cc6c"
        inactive-color "#69573a"
        urgent-color   "#fd6883"
    }

    insert-hint {
        color "#f9cc6c80"
    }
}

recent-windows {
    highlight {
        active-color "#f9cc6c"
        urgent-color "#fd6883"
    }
}
